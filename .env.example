DATABASE_URL=sqlite+aiosqlite:///./polymarket_dev.db

# --- Polygon Wallet (required for order book read AND live trading) ---
# How to get these:
# 1. Install MetaMask at metamask.io
# 2. Switch network to "Polygon Mainnet" (Chain ID 137)
# 3. Create or import a wallet — this will hold your $100 USDC
# 4. Export private key: MetaMask → Account → ⋮ → Account Details → Show Private Key
# 5. Your wallet address is shown at the top of MetaMask (starts with 0x)
POLYGON_PRIVATE_KEY=     # paste from MetaMask export (starts with 0x)
POLYGON_WALLET_ADDRESS=  # paste your 0x address

# --- Brave Search (for real-time political news) ---
# How to get:
# 1. Go to https://api.search.brave.com/
# 2. Click "Get Started Free"
# 3. Sign up → Dashboard → API Keys → Create Key
# Free tier: 2,000 queries/month
BRAVE_API_KEY=

# --- NewsAPI (for headline sentiment scoring) ---
# How to get:
# 1. Go to https://newsapi.org/
# 2. Click "Get API Key"
# Free tier: 100 requests/day
NEWS_API_KEY=

# --- Metaculus (for political market consensus probabilities) ---
# How to get:
# 1. Go to https://www.metaculus.com — create a free account
# 2. Profile → Settings → API → Generate token
METACULUS_API_KEY=

# ── Kalshi (public API — no auth needed, just configure thresholds) ──
# KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_CACHE_TTL_SECONDS=300
# KALSHI_SIMILARITY_THRESHOLD=0.45
# DAILY_RECOMMENDATION_COUNT=3

# --- Safety gate ---
# LIVE_TRADING=true  # WARNING: only uncomment after 30+ validated paper trades AND all metrics pass

SIGNAL_PROVIDER=politics_signal
# SIGNAL_PROVIDER=null_signal   ← disabled, was the default placeholder
MAX_SINGLE_POSITION_USD=10
MAX_TOTAL_EXPOSURE_USD=100
